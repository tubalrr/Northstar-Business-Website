rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNorthstarAdmin() {
      return request.auth != null
        && request.auth.token.email == "REPLACE_WITH_ADMIN_EMAIL";
    }

    match /consultationRequests/{requestId} {
      // Public visitors may create a well-formed request, but cannot read,
      // list, update, or delete requests.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'type', 'preferredDate',
          'goals', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'type', 'preferredDate',
          'goals', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 90
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('.*@.*')
        && request.resource.data.type in [
          'Consultation', 'General inquiry', 'New project',
          'Website / digital concept', 'Business strategy', 'Other'
        ]
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() <= 10
        && request.resource.data.goals is string
        && request.resource.data.goals.size() <= 1200
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'northstar-website'
        && request.resource.data.createdAt == request.time;

      // Only the explicitly configured admin account can access the inbox.
      allow read, list: if isNorthstarAdmin();

      // Admin can update only the status field and its server timestamp.
      allow update: if isNorthstarAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in [
          'new', 'in progress', 'contacted', 'closed'
        ]
        && request.resource.data.updatedAt == request.time;

      allow delete: if isNorthstarAdmin();
    }

    // No other collections are accessible from the public web app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
